AIRFLOW_POSTGRES_DB=airflow
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=replace-with-url-safe-random-value
AIRFLOW_FERNET_KEY=replace-with-generated-fernet-key
AIRFLOW_API_JWT_SECRET=replace-with-random-value
AIRFLOW_API_SECRET_KEY=replace-with-random-value
AIRFLOW_SIMPLE_AUTH_MANAGER_USERS=admin:admin

QBO_GATEWAY_BASE_URL=http://host.docker.internal:8000
QBO_GATEWAY_API_KEY=replace-with-qbo-gateway-key
AUTOMATION_GATEWAY_BASE_URL=http://host.docker.internal:8002
AUTOMATION_GATEWAY_API_KEY=replace-with-automation-gateway-key
REQUEST_TIMEOUT_SECONDS=30
QBO_CHECK_MAX_ATTEMPTS=3
QBO_CHECK_RETRY_DELAY_SECONDS=5
